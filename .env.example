# ── LLM provider ──────────────────────────────────────────────────────────────
# Pick ONE. Checked in this order: OpenAI → Groq → Ollama.
# With none set, everything still works: briefs are extractive and /ask returns
# the most relevant passages without a synthesized answer.

# Groq — free tier, no credit card. https://console.groq.com → API Keys
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-20b

# OpenAI — paid. https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-4o-mini

# Ollama — fully local. Install from https://ollama.com/download, then:
#   ollama pull qwen2.5:7b && ollama pull nomic-embed-text
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_BASE_URL=http://localhost:11434

# ── Embeddings ────────────────────────────────────────────────────────────────
# Auto: OpenAI if its key is set, Ollama if configured, otherwise a free local
# model (all-MiniLM-L6-v2, ~23 MB, downloaded once into .cache/models).
# EMBEDDING_PROVIDER=local          # local | openai | ollama | none
# HYBRID_KEYWORD_WEIGHT=0.25        # BM25 weight in rank fusion (vector = 1)

# ── Access & limits (set before exposing the app publicly) ────────────────────
# APP_ACCESS_TOKEN=change-me        # login page / Authorization: Bearer <token>
# RATE_LIMIT_PER_MIN=30             # per-IP, on LLM and fetch endpoints
# ALLOW_PRIVATE_URLS=false          # true allows intranet URLs (disables SSRF block)

# ── Scraping ──────────────────────────────────────────────────────────────────
# Headless Chrome/Chromium is used for JS-rendered pages when found.
# BROWSER_SCRAPE=true
# CHROME_PATH=/usr/bin/chromium

# ── Slack (optional) ──────────────────────────────────────────────────────────
# SLACK_SIGNING_SECRET=...          # required — events are rejected without it
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_WEBHOOK_URL=https://hooks.slack.com/...   # weekly digest, Mondays 8:00
# NEXT_PUBLIC_BASE_URL=https://your-domain

# ── Storage ───────────────────────────────────────────────────────────────────
# DATA_DIR=./data
# SEED_ON_BOOT=true                 # pull a few feed items into an empty library
